{
  "name": "block-pool-checker",
  "private": true,
  "description": "Check a football block pool from your phone: photograph the sheet, see the winning blocks.",
  "license": "MIT",
  "author": "Eric Ruth",
  "homepage": "https://github.com/ESRuth/block-pool-checker#readme",
  "bugs": "https://github.com/ESRuth/block-pool-checker/issues",
  "keywords": [
