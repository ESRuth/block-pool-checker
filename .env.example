# Copy to .env (gitignored) for local development. Never commit real values.
# Gemini runs on Vertex AI with your gcloud login locally (no key); in production it uses the Cloud Run service account.
GOOGLE_CLOUD_PROJECT=block-pool-checker
# Local API only: set to test access control; leave unset for an open local API. Never set GCP_PROJECT locally without it.
# INVITE_CODE=
# READER=stub            # offline mode: recorded names/digits and one recorded game, no model or ESPN calls (free UI testing; the e2e tests use it)
# READER_MODEL=gemini-3.6-flash
# READER_THINKING=minimal
# READ_CAP_PER_DAY=40
# Production owner code used by the deploy command (see docs/DEPLOY.md). Not read by the app itself.
# INVITE_CODE_PROD=
